    {
      "id": 10,
      "type": "table",
      "title": "Patch plan",
      "description": "Upgrades ranked by the plan's ordering, for agents seen recently. Each row clears the findings shown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (rank, package, current_version, target_version, kernel, hosts) (vulnfold_action_findings{instance=~\"$instance\"})",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (rank, package, current_version, target_version, kernel, hosts) (vulnfold_action_criticals{instance=~\"$instance\"})",
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (rank, package, current_version, target_version, kernel, hosts) (vulnfold_action_cves{instance=~\"$instance\"})",
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (rank, package, current_version, target_version, kernel, hosts) (vulnfold_action_agents{instance=~\"$instance\"})",
          "refId": "D",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "rank": "#",
              "package": "Package",
              "current_version": "Installed",
              "target_version": "Upgrade to",
              "hosts": "Hosts",
              "kernel": "Kernel",
              "Value #A": "Findings",
              "Value #B": "Critical",
              "Value #C": "CVEs",
              "Value #D": "Host count"
            },
            "indexByName": {
              "rank": 0,
              "package": 1,
              "current_version": 2,
              "target_version": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7,
              "hosts": 8,
              "kernel": 9
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "#",
                "desc": false
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "#"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hosts"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Package"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 240
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "What the first actions clear",
      "description": "Cumulative share of fixable findings and criticals cleared by the first N actions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (actions) (vulnfold_coverage_percent{measure=\"criticals\",instance=~\"$instance\"})",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (actions) (vulnfold_coverage_percent{measure=\"findings\",instance=~\"$instance\"})",
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "actions",
            "mode": "outer"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "actions",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "actions",
                "desc": false
