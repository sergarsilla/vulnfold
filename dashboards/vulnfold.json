{
  "title": "vulnfold \u2014 patch plan",
  "uid": "vulnfold-patch-plan",
  "description": "What to upgrade first, and what has no fix. Fed by `vulnfold scan --metrics`.",
  "tags": [
    "vulnfold",
    "wazuh",
    "vulnerabilities"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(vulnfold_last_scan_timestamp_seconds, instance)",
          "refId": "q"
        },
        "definition": "label_values(vulnfold_last_scan_timestamp_seconds, instance)",
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last scan",
      "description": "Time since the last successful scan. Red after 26 h: the daily scan did not run or failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(vulnfold_last_scan_timestamp_seconds{instance=~\"$instance\"})",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fixable findings",
      "description": "Findings a published upgrade clears.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(vulnfold_findings{class=\"fixable\",instance=~\"$instance\"})",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
